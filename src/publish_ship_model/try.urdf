<?xml version="1.0"?>
<robot name="example_robot">
  <!-- Define the base frame -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="1 1 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 1.0 1.0"/>
      </material>
    </visual>
  </link>

  <!-- A child link -->
  <link name="ship_center">
    <visual>
      <geometry>
        <cylinder length="0.5" radius="0.1"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Joint to connect links -->
  <joint name="base_to_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="ship_center"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
  </joint>
</robot>
